# Copy this file to .env.local and fill in your real keys.
# Never commit .env.local to git.

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Anthropic (Claude) — actif par défaut ===
ANTHROPIC_API_KEY=sk-ant-...

# === OpenAI (GPT-4o, GPT-4o-mini) — optionnel ===
# Pour activer GPT sur les agents : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# === DeepSeek (deepseek-chat V3, deepseek-reasoner R1) — optionnel ===
# Compatible OpenAI API, ratio coût/qualité agressif.
# Crée la clé : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# === Google Gemini — optionnel (déjà utilisé pour génération d'images) ===
GEMINI_API_KEY=your-gemini-key

# === fal.ai (image generation) ===
FAL_KEY=your-fal-key
